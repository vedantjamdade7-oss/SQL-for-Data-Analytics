JOINS in SQL

Joins are used to combine data from multiple tables based on a related column.

TYPE OF JOINS

1️⃣ INNER JOIN
🔹Returns only matching rows from both tables.

2️⃣ LEFT JOIN (LEFT OUTER JOIN)
🔹All rows from the left table
🔹Matching rows from the right table
🔹NULL if no match

3️⃣ RIGHT JOIN (RIGHT OUTER JOIN)
🔹All rows from the right table
🔹Matching rows from the left table

4️⃣ FULL JOIN (FULL OUTER JOIN)
🔹All rows from both tables
🔹NULL where there is no match

EXAMPLE:

USE market_star_schema;

-- INNER JOIN
SELECT * FROM cust_dimen cd
INNER JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id;

-- LEFT JOIN
SELECT * FROM 
cust_dimen cd LEFT JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id;

-- RIGHT JOIN
SELECT * FROM 
cust_dimen cd RIGHT JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id;

-- FULL JOIN
SELECT * FROM cust_dimen cd
JOIN market_fact_full mff
USING (cust_id);


-- Multiple Joins
SELECT * FROM cust_dimen cd
JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id
JOIN orders_dimen od 
ON mff.ord_id=od.ord_id
JOIN shipping_dimen sd
ON sd.ship_id=mff.ship_id
JOIN prod_dimen pd
ON pd.prod_id=mff.prod_id;

-- find the sum of sales from each city
SELECT city, ROUND(SUM(sales),2) AS total_sales  FROM 
cust_dimen cd JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id
GROUP BY city
ORDER BY total_sales DESC;

-- find the total sales for each month and year of the orders.
SELECT 
    YEAR(order_date) AS year,
    MONTH(order_date) AS month,
    SUM(sales) AS total_sales
FROM market_fact_full mff
JOIN orders_dimen od ON mff.ord_id = od.ord_id
GROUP BY YEAR(order_date), MONTH(order_date)
ORDER BY year, month;

--  find the total sales for each city in which the orders placed in years of 2011 and 2012
SELECT city, SUM(sales) AS total_sales FROM cust_dimen cd
JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id
JOIN orders_dimen od 
ON mff.ord_id=od.ord_id
WHERE YEAR(order_date) IN ('2011','2012')
GROUP BY city;

/* find the total sales for each city in which the orders placed in years of 2011 and 2012
and has regular air as ship mode and office supplies as product category */
SELECT city, SUM(sales) AS total_sales  FROM cust_dimen cd
JOIN market_fact_full mff
ON cd.cust_id=mff.cust_id
JOIN orders_dimen od 
ON mff.ord_id=od.ord_id
JOIN shipping_dimen sd
ON sd.ship_id=mff.ship_id
JOIN prod_dimen pd
ON pd.prod_id=mff.prod_id
WHERE YEAR(order_date) IN ('2011','2012')
AND ship_mode='Regular Air'
AND product_category='OFFICE SUPPLIES'
GROUP BY city;